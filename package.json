{
  "name": "@yeisme/control-center",
  "version": "0.1.0",
  "description": "Yeisme read-only service control center",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4298",
    "dev:v18": "vite --host 127.0.0.1 --port 4299",
    "preview:demo": "vite --host 127.0.0.1 --port 4298 --mode demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "test:ui": "node scripts/verify-design-v18.mjs",
    "handoff": "node scripts/package-source.mjs",
    "build:demo": "vite build --mode demo",
    "serve": "bun server/index.ts",
    "serve:v18": "YEISME_V18_DEMO=1 YEISME_CONTROL_ORIGIN=http://127.0.0.1:4313 YEISME_CONTROL_PORT=4313 bun server/index.ts",
    "test:live": "node scripts/verify-live.mjs",
    "test:workspace": "node scripts/verify-workspace-v6.mjs",
    "test:owners": "node scripts/verify-owners.mjs",
    "test:provider-live": "bun scripts/test-provider-live.ts",
    "test:task-visibility": "bun scripts/verify-task-visibility.ts",
    "test:v18": "node scripts/verify-design-v18.mjs"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@react-spring/web": "10.1.2",
    "@tanstack/react-table": "9.2.4",
    "lucide-react": "1.24.0",
    "radix-ui": "1.6.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-is": "19.2.3",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "fflate": "0.8.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.2.7",
    "vitest": "4.0.15"
  }
}
