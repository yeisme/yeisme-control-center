{
  "name": "@yeisme/control-center",
  "version": "0.2.0-rc.1",
  "description": "Yeisme read-only service control center",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4298",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "test:ci:browser": "node scripts/verify-ci-browser.mjs",
    "check:public-surface": "node scripts/check-public-surface.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "preview:real": "bun scripts/start-dev-preview.mjs",
    "preview:fixture": "bun scripts/fixture-preview.ts",
    "test:browser-journey": "bun scripts/verify-browser-journey.ts",
    "test:preview:real": "node scripts/verify-dev-preview.mjs",
    "serve": "bun server/index.ts",
    "test:owners": "node scripts/verify-owners.mjs",
    "test:provider-live": "bun scripts/test-provider-live.ts",
    "test:v18": "node scripts/verify-app.mjs",
    "test:owner-live-read": "bun scripts/verify-real-owner-reads.ts",
    "test:task-visibility": "bun scripts/verify-task-visibility.ts",
    "test:app": "node scripts/verify-app.mjs",
    "test:contract-integration": "bun scripts/verify-contract-integration.ts",
    "test:server-boot": "bun scripts/verify-server-boot.ts",
    "db:generate": "drizzle-kit generate"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@react-spring/web": "10.1.2",
    "@tanstack/react-table": "9.2.4",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "1.24.0",
    "radix-ui": "1.6.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-is": "19.2.3",
    "react-router-dom": "^7",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "drizzle-kit": "^0.31.11",
    "fflate": "0.8.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.2.7",
    "vitest": "4.0.15"
  }
}
