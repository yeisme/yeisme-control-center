+import { useState } from 'react'
+import { Activity, ArrowUpRight, Server, ShieldCheck } from 'lucide-react'
+import { Badge, Button, Modal } from './components/ui/shared'
+import type { Project } from './model'
+
+const controlPath = '/api/projects/yeisme-service-control-center/raw/index.html'
+const returnPages = new Set(['home', 'projects', 'script', 'canvas', 'storyboard', 'audio', 'assets', 'tasks', 'reviews'])
+
+export function controlCenterUrl(project: Pick<Project, 'id' | 'selectedShot'>, view: 'overview' | 'services' | 'tasks' | 'audit' = 'overview', taskId?: string, serviceId?: string, returnPage = 'tasks') {
+  const origin = typeof location !== 'undefined' && location.pathname.startsWith('/api/projects/') ? location.origin : 'http://10.10.1.101:7456'
+  const url = new URL(controlPath, origin)
+  const query = new URLSearchParams({ source: 'frame', env: 'main', source_project: project.id, return_page: returnPages.has(returnPage) ? returnPage : 'tasks' })
+  if (project.selectedShot) query.set('source_shot', project.selectedShot)
+  if (taskId) query.set('source_task', taskId)
+  if (serviceId && ['scaena', 'eikona', 'sonora', 'auctra', 'anatomia'].includes(serviceId)) query.set('service', serviceId)
+  url.hash = `/${view}?${query}`
+  return url.href
+}
+
+export function ControlCenterLink({ project, expanded }: { project: Project; expanded: boolean }) {
+  return <a href={controlCenterUrl(project, 'overview', undefined, undefined, location.hash.replace('#/', '').split('?')[0])} target="_blank" rel="noopener noreferrer" aria-label="控制中心（新标签页）" className={`flex h-9 w-full items-center rounded-lg text-muted-foreground hover:bg-muted ${expanded ? 'gap-3 px-3' : 'justify-center'}`}><Server size={18}/>{expanded && <><span className="text-sm">控制中心</span><ArrowUpRight size={14} className="ml-auto"/></>}</a>
+}
+
+export function ProjectServiceStatus({ project, page }: { project: Project; page: string }) {
+  const [open, setOpen] = useState(false)
+  const dependencies = [{ id: 'scaena', name: 'Scaena', purpose: '生产、任务与交付' }, { id: 'eikona', name: 'Eikona', purpose: '图片与视觉资产' }, { id: 'sonora', name: 'Sonora', purpose: '声音、字幕与权利' }, { id: 'auctra', name: 'Auctra', purpose: '文稿与接受修订' }, { id: 'anatomia', name: 'Anatomia', purpose: '拉片与时序证据' }]
+  return <><Button variant="ghost" size="sm" aria-label="服务状态" onClick={() => setOpen(true)}><Activity size={15}/><span>服务状态</span></Button><Modal open={open} onClose={() => setOpen(false)} title="当前项目服务状态" description={`${project.name} · 只查看当前创作依赖，不改变作品与草稿。`}><div className="rounded-lg border bg-muted/40 p-4 text-sm leading-6"><div className="mb-2 flex items-center gap-2"><ShieldCheck size={16}/><strong>客户端接线待完成</strong></div><p className="text-muted-foreground">远程 MCP 可用与片场已接线是两项独立事实。本原型没有探测真实服务，因此不显示虚假的健康状态。</p><p className="mt-2 text-xs text-muted-foreground">最近检查：尚未进行真实检查</p></div><div className="divide-y">{dependencies.map(s => <div key={s.id} className="flex items-center gap-3 py-3.5"><Server size={18} className="text-muted-foreground"/><span className="flex-1"><strong className="block text-sm">{s.name}</strong><span className="text-xs text-muted-foreground">{s.purpose}</span></span><Badge>待接线</Badge><a className="inline-flex items-center gap-1 rounded-md px-2 py-2 text-sm hover:bg-muted" href={controlCenterUrl(project, 'services', undefined, s.id, page)} target="_blank" rel="noopener noreferrer" aria-label={`在控制中心查看 ${s.name}`}>查看<ArrowUpRight size={14}/></a></div>)}</div><div className="flex justify-end"><a className="inline-flex h-9 items-center gap-2 rounded-lg bg-primary px-4 text-sm text-primary-foreground" href={controlCenterUrl(project, 'services', undefined, undefined, page)} target="_blank" rel="noopener noreferrer">打开控制中心<ArrowUpRight size={15}/></a></div></Modal></>
+}
+
+export function TaskDiagnosticsLink({ project, taskId, status, shotId }: { project: Project; taskId: string; status: string; shotId?: string }) {
+  if (!['failed', 'unknown'].includes(status)) return null
+  return <a href={controlCenterUrl({ ...project, selectedShot: shotId || project.selectedShot }, 'tasks', taskId, undefined, 'tasks')} target="_blank" rel="noopener noreferrer" className="inline-flex h-8 items-center gap-1 rounded-lg border px-2 text-sm hover:bg-muted" aria-label={`查看诊断 ${taskId}`}>查看诊断<ArrowUpRight size={13}/></a>
+}
