+import { describe, expect, it } from 'vitest'
+import { controlCenterUrl } from '../../src/ControlCenter'
+
+describe('control center launch context', () => {
+  it('retains original project, task and shot without inventing owner bindings', () => {
+    const u = new URL(controlCenterUrl({ id: 'project-original', selectedShot: 'shot-2' }, 'tasks', 'task-original'))
+    const q = new URLSearchParams(u.hash.split('?')[1])
+    expect(q.get('source_project')).toBe('project-original')
+    expect(q.get('source_task')).toBe('task-original')
+    expect(q.get('source_shot')).toBe('shot-2')
+    expect(q.has('project')).toBe(false)
+    expect(u.pathname).toBe('/api/projects/yeisme-service-control-center/raw/index.html')
+  })
+  it('restricts return routes and service selection', () => {
+    const u = new URL(controlCenterUrl({ id: 'p', selectedShot: '' }, 'services', undefined, 'unregistered', 'https://untrusted.invalid'))
+    const q = new URLSearchParams(u.hash.split('?')[1])
+    expect(q.get('return_page')).toBe('tasks')
+    expect(q.has('service')).toBe(false)
+  })
+})
